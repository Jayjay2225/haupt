# Produktvariante: privat (Standard) | kanzlei (markenneutrale Kanzlei-Lizenz)
NEXT_PUBLIC_PRODUKT_VARIANTE=privat

# Beta-Schutz: gesetzt = Basic-Auth vor allen Seiten
BETA_PASSWORT=
# Suchmaschinen: erst zum Go-live auf 1 setzen (sonst noindex)
NEXT_PUBLIC_INDEXIERUNG=

# Öffentliche Basis-URL (für Rück-Links aus der Zahlungsabwicklung)
NEXT_PUBLIC_BASIS_URL=http://localhost:3000

# Zahlung (Stripe Checkout: Karte, SEPA, PayPal, Klarna). Ohne STRIPE_SECRET_KEY ist die Bestellung aus.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional: Zahlungsarten (Stripe-Kennungen), Standard card,sepa_debit,paypal,klarna – im Stripe-Dashboard aktivieren
STRIPE_ZAHLUNGSARTEN=card,sepa_debit,paypal,klarna
# Optional: Steuersatz-Objekt (19 % inklusiv) für den Umsatzsteuer-Ausweis auf der Stripe-Rechnung
STRIPE_STEUERSATZ_ID=

# Freischaltcodes (Prompt 12): kommagetrennt; Eintrag = CODE oder CODE|einmalig/mehrfach|ABLAUF(ISO)|PARTNER; leer = Programm aus
ERSTKUNDEN_CODES=

# Fondsgebundene Verträge: anfrage (Standard, individuelle Prüfung) | berechnen (Formel trotzdem anwenden)
FONDS_MODE=

# 12-Stunden-Versand (Prompt 13): Admin-Freigabeliste unter /admin?schluessel=…, Cron-Schutz
ADMIN_PASSWORT=
CRON_SECRET=

# „Warum über uns“ und Preis-Anrechnung (Prompt 13): nur mit Beleg/Entscheidung füllen
NEXT_PUBLIC_PARTNERKANZLEI=
NEXT_PUBLIC_GEPRUEFTE_POLICEN=
NEXT_PUBLIC_PREIS_ANRECHNUNG=

# Auslieferung: Ablageordner für Berichte und Mail-Protokolle (Standard: <cwd>/var/auslieferungen)
AUSLIEFERUNG_VERZEICHNIS=
# E-Mail-Versand: gesetzt = Resend-API; leer = Protokoll-Modus (Datei statt Versand)
RESEND_API_KEY=
MAIL_ABSENDER="Renten-Rettung <info@renten-rettung.de>"
# Chromium für die PDF-Erzeugung (Standard: /opt/pw-browsers/chromium)
CHROMIUM_PATH=

# Kanzlei-Variante (NEXT_PUBLIC_PRODUKT_VARIANTE=kanzlei): Anbieterdaten der Kanzlei
NEXT_PUBLIC_KANZLEI_NAME=
NEXT_PUBLIC_KANZLEI_DOMAIN=
NEXT_PUBLIC_KANZLEI_ANBIETER=
NEXT_PUBLIC_KANZLEI_STRASSE=
NEXT_PUBLIC_KANZLEI_PLZ=
NEXT_PUBLIC_KANZLEI_ORT=
NEXT_PUBLIC_KANZLEI_VERTRETUNG=
NEXT_PUBLIC_KANZLEI_REGISTER=
NEXT_PUBLIC_KANZLEI_USTID=
NEXT_PUBLIC_KANZLEI_TELEFON=
NEXT_PUBLIC_KANZLEI_EMAIL=
