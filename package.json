{
  "name": "lv-rueckabwicklung",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --filter @rueckab/web dev",
    "build": "pnpm --filter @rueckab/web build",
    "test": "vitest run",
    "typecheck": "pnpm -r typecheck",
    "data:check": "node --experimental-strip-types scripts/update-insurers.ts check",
    "data:scans": "node --experimental-strip-types scripts/data-scans.ts check",
    "data:bafin": "node --experimental-strip-types scripts/import-bafin.ts import",
    "data:altjahre": "node --experimental-strip-types scripts/import-altjahre.ts check"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^3.2.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
